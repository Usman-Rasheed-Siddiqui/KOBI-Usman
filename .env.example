# Neon PostgreSQL
# Pooled application connection (hostname normally contains `-pooler`).
# Example: postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_8RoEVgNU1OMG@ep-ancient-breeze-av1l1mxe-pooler.c-11.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct connection used by Prisma CLI for schema changes/migrations.
# Example: postgresql://USER:PASSWORD@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://neondb_owner:npg_8RoEVgNU1OMG@ep-ancient-breeze-av1l1mxe-pooler.c-11.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional for higher GitHub API limits and GitHub discovery without OAuth login
GITHUB_TOKEN=

# Gemini / KOBI Agent
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Search / crawler
KOBI_BASE_URL=http://localhost:3000
DISCOVERY_GLOBAL_CONCURRENCY=8
DISCOVERY_GITHUB_CONCURRENCY=1
DISCOVERY_GITLAB_CONCURRENCY=2
DISCOVERY_CODEBERG_CONCURRENCY=2
DISCOVERY_EVENT_CONCURRENCY=2
DISCOVERY_FEED_CONCURRENCY=3
# Optional headless-browser fallback for approved JS-rendered event pages.
# Requires: npx playwright install chromium
DISCOVERY_BROWSER_FALLBACK=false

# Optional comma-separated approved public event pages/feeds for custom adapters.
# Only URLs explicitly configured here may be fetched by the generic event crawler.
APPROVED_EVENT_SOURCES=
# Optional comma-separated RSS/Atom feeds explicitly approved by the operator.
APPROVED_FEED_SOURCES=
